FROM node:22-bookworm AS web-builder

ARG APP_VERSION=1.19.5
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

WORKDIR /src/web
COPY web/package.json web/pnpm-lock.yaml* ./
RUN corepack enable && pnpm config set registry "${NPM_CONFIG_REGISTRY}" && pnpm install --frozen-lockfile
COPY web/ ./
RUN NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_APP_VERSION="${APP_VERSION}" pnpm run build

FROM --platform=$BUILDPLATFORM golang:1.24.4-bookworm AS app-builder

ARG APP_VERSION=1.19.5
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG GOPROXY=https://proxy.golang.org,direct
ARG GOSUMDB=sum.golang.org

WORKDIR /src
COPY go.mod go.sum ./
RUN export GOPROXY="${GOPROXY}" GOSUMDB="${GOSUMDB}" && \
    n=0 && until [ "$n" -ge 3 ]; do \
      go mod download && break; \
      n=$((n+1)); \
      echo "go mod download failed, retry ${n}/3" >&2; \
      sleep $((n*3)); \
    done && [ "$n" -lt 3 ]
COPY . ./
COPY --from=web-builder /src/web/out ./static/out
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/octopus -ldflags="-X github.com/xiaoli0412/octopus-xiaoli-repo/internal/conf.Version=${APP_VERSION} -s -w" -tags=jsoniter ./

FROM debian:bookworm-slim

ENV TZ=Asia/Shanghai \
    PUID=10001 \
    PGID=10001

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata gosu && \
    ln -fs /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    dpkg-reconfigure -f noninteractive tzdata && \
    groupadd --system --gid 10001 octopus && \
    useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin octopus && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /app/data && \
    chown -R 10001:10001 /app

COPY --from=app-builder /out/octopus /app/octopus
COPY scripts/dockerfiles/entrypoint.sh /entrypoint.sh

RUN chmod +x /app/octopus /entrypoint.sh

CMD ["/entrypoint.sh"]
